# Copy this file to .env and fill in your values.
# The .env file itself is git-ignored and must never be committed.

# Supabase (from your Supabase dashboard: Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only needed for automated tests; safe to leave blank
BOLT_TEST_USER_EMAIL=
BOLT_TEST_USER_PASSWORD=
